+static errno_t
+source_entitlement_free_validate(struct cs_blob *cs_blob)
+{
+	if (amfi != NULL) {
+		return 0;
+	}
+	if ((cs_blob->csb_flags & (CS_VALID | CS_ADHOC)) != (CS_VALID | CS_ADHOC) ||
+	    cs_blob->csb_entitlements != NULL) {
+		goto refuse;
+	}
+	void *xml = NULL;
+	const CS_GenericBlob *der = NULL;
+	size_t xml_length = 0, der_length = 0;
+	int xml_error = csblob_get_entitlements(cs_blob, &xml, &xml_length);
+	int der_error = csblob_get_der_entitlements(cs_blob, &der, &der_length);
+	if (xml_error != 0 || der_error != 0) {
+		goto refuse;
+	}
+	/* Also check raw pointers BEFORE reconstitution can discard XML data.
+	 * An unsigned/zero-hash XML blob must not turn into an absent context.
+	 */
+	if (xml != NULL || der != NULL || xml_length != 0 || der_length != 0 ||
+	    cs_blob->csb_entitlements_blob != NULL || cs_blob->csb_der_entitlements_blob != NULL) {
+		os_atomic_inc(&source_entitlement_free_entitlement_refusals, relaxed);
+		goto refuse;
+	}
+	return 0;
+refuse:
+	os_atomic_inc(&source_entitlement_free_refusals, relaxed);
+	return EPERM;
+}
+#endif
