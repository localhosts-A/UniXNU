+__private_extern__
+int
+kernel_mount_localargs(const char *fstype, const char *path,
+    const char *device_path, void *filesystem_args, int syscall_flags,
+    vfs_context_t ctx)
+{
+	struct kernel_local_mount_args args;
+
+	if (fstype == NULL || path == NULL || device_path == NULL ||
+	    device_path[0] == '\0' || filesystem_args == NULL ||
+	    (syscall_flags & (MNT_UPDATE | MNT_RELOAD | MNT_FORCE)) != 0) {
